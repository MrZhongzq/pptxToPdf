server {
    listen 443 ssl;
    http2 on;
    server_name pptx.example.com;

    # 证书路径按实际部署修改。缺这两行 nginx 起不来。
    ssl_certificate     /etc/letsencrypt/live/pptx.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pptx.example.com/privkey.pem;

    # 分片上传后单次请求体只有 5 MiB，无需为 500MB 放宽。
    # 留 16m 余量覆盖块加请求头。改大它没有好处，只会削弱防护。
    client_max_body_size 16m;
    client_body_timeout 120s;

    # 前端静态资源
    location / {
        root /srv/pptx2pdf/frontend/dist;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 大文件下载不缓冲，避免占满内存
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # 字体是整份文件一次 multipart 提交，不像 pptx 那样分片，所以上面
    # 那个 16m 挡不住它——真机实测 19MB 的 msyh.ttc 直接吃 413。
    # 单独放宽这一个端点，而不是整体调大 /api/：其余端点没有大 body 的
    # 理由，无差别放宽只是白白扩大攻击面。
    # 故意比后端 admin_fonts.py 里的 MAX_FONT_BYTES（64 MiB）大 1m，而不是
    # 完全对齐：nginx 这个限制管的是整个 multipart body（文件内容 + 边界
    # + 表单字段），后端那个限制管的是文件内容本身。两者恰好相等的话，
    # 64 MiB 的字体会先被 nginx 以裸 HTML 413 拒掉，前端 parseError 解不出
    # JSON，管理员看到的是干巴巴的 HTTP 413，而不是「字体文件不能超过
    # 64 MB」——留 1m 余量让请求先进后端，由后端出友好文案。
    location = /api/admin/fonts/preflight {
        client_max_body_size 65m;

        # 精确匹配的 location 不继承上面 /api/ 的配置，照抄一份。
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
