    "/api/admin/graph-credentials": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Get Graph Credentials",
        "operationId": "get_graph_credentials_api_admin_graph_credentials_get",
        "parameters": [
          {
            "name": "pptx2pdf_admin",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pptx2Pdf Admin"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphCredentialsDto"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Put Graph Credentials",
        "description": "先测后存：五步自检全绿才写库。\n\n配错的凭证一旦入库，三期的引擎每次转换都会去读它——期间所有走\nGraph 的任务都会失败，而失败原因（一个 Graph 原始报错）与「你配错\n了」之间隔着数层抽象。这条顺序把那个窗口彻底关闭：run_selftest 在\nsave_credentials 之前调用且不捕获它的异常，任何一步——包括\nrun_selftest 内部未预期的穿透异常——都会在触达 save_credentials 之前\n终止请求，数据库不会被写入半条记录。",
        "operationId": "put_graph_credentials_api_admin_graph_credentials_put",
        "parameters": [
          {
            "name": "pptx2pdf_admin",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pptx2Pdf Admin"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphCredentialsUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelftestResultDto"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/logout": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Logout",
        "description": "不要求鉴权：语义是清掉浏览器上的 cookie，cookie 已过期时同样应该成功。\n若要求鉴权，过期后点登出会得到 401，而用户想做的恰恰是清理这个失效状态。",
        "operationId": "logout_api_admin_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminLoginRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "AdminLoginRequest"
      },
      "CapacityConfig": {
        "properties": {
          "max_file_size": {
            "type": "integer",
            "title": "Max File Size"
          },
          "graph_max_shards": {
            "type": "integer",
            "title": "Graph Max Shards"
          },
          "graph_max_shard_bytes": {
            "type": "integer",
            "title": "Graph Max Shard Bytes"
          },
          "graph_max_merge_bytes": {
            "type": "integer",
            "title": "Graph Max Merge Bytes"
          }
        },
        "type": "object",
        "required": [
          "max_file_size",
          "graph_max_shards",
          "graph_max_shard_bytes",
          "graph_max_merge_bytes"
        ],
        "title": "CapacityConfig",
        "description": "容量相关的只读配置，供前端在选 Graph 引擎时做上传前的启发式预判。\n\n只吐这几个纯数字，不吐任何凭证/配置状态（如 Graph 是否已配置）——那属于\n四期管理页范畴，也是信息泄露面，这轮不碰。四个字段直接来自\napp.config.settings 单例，端点里不另存一份，避免和后端实际配置漂移。"
      },
      "ChunkAck": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "received_count": {
            "type": "integer",
            "title": "Received Count"
          }
        },
        "type": "object",
        "required": [
          "index",
          "received_count"
        ],
        "title": "ChunkAck"
      },
      "CompleteResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          }
        },
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "CompleteResponse"
      },
      "ConversionOptions": {
        "properties": {
          "expand_animations": {
            "type": "boolean",
            "title": "Expand Animations",
            "default": false
          },
          "pdf_outline": {
            "type": "boolean",
            "title": "Pdf Outline",
            "default": false
          },
          "remap_margins": {
            "type": "boolean",
            "title": "Remap Margins",
            "default": false
          }
        },
        "type": "object",
        "title": "ConversionOptions",
        "description": "转换后处理选项。\n\n后端目前只接收并落库，不实现任何一项——字段先定下来，\n将来实现时不用再改前后端契约。前端会在每项旁标注实现状态。"
      },
      "CreateUploadRequest": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename"
          },
          "size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConversionOptions"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "filename",
          "size"
        ],
        "title": "CreateUploadRequest"
      },
      "CreateUploadResponse": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "chunk_size": {
