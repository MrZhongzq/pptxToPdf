  "components": {
    "schemas": {
      "ChunkAck": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "received_count": {
            "type": "integer",
            "title": "Received Count"
          }
        },
        "type": "object",
        "required": [
          "index",
          "received_count"
        ],
        "title": "ChunkAck"
      },
      "CompleteResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          }
        },
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "CompleteResponse"
      },
      "CreateUploadRequest": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename"
          },
          "size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "size"
        ],
        "title": "CreateUploadRequest"
      },
      "CreateUploadResponse": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "chunk_size": {
            "type": "integer",
            "title": "Chunk Size"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "chunk_size",
          "total_chunks",
          "expires_at"
        ],
        "title": "CreateUploadResponse"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "description": "所有 API 错误的统一形状，码值取自 app/errors.py。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TaskDto": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "slide_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slide Count"
          },
          "slide_width_emu": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slide Width Emu"
          },
          "slide_height_emu": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slide Height Emu"
          },
          "fonts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fonts"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "status",
          "engine",
          "original_filename",
          "size_bytes",
          "slide_count",
          "slide_width_emu",
          "slide_height_emu",
          "fonts",
          "error_code",
          "error_message",
          "created_at"
        ],
        "title": "TaskDto"
      },
      "UploadStatus": {
        "properties": {
          "received_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Received Indices"
          },
          "bytes_received": {
            "type": "integer",
            "title": "Bytes Received"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "chunk_size": {
            "type": "integer",
            "title": "Chunk Size"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "received_indices",
          "bytes_received",
          "total_chunks",
          "chunk_size",
          "status"
        ],
        "title": "UploadStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
